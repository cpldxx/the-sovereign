# Sovereign KG API (REST + MCP at /mcp)
SOVEREIGN_KG_URL=http://localhost:8080

# Head Agent model — "<provider>:<model>", ollama: or anthropic:.
# Hermes requires a >=64K context window: qwen3.6:35b (262K) works; qwen2.5:32b (32K) is rejected.
# Claude: HEAD_MODEL=anthropic:claude-sonnet-5-5 and set ANTHROPIC_API_KEY.
HEAD_MODEL=ollama:qwen3.6:35b
# Thinking off answers in seconds instead of minutes; turn on for deeper reasoning.
HEAD_THINKING=false
ANTHROPIC_API_KEY=

# Ollama's OpenAI-compatible endpoint (for ollama: models)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Tracing (optional) — LangFuse (Hermes' bundled langfuse plugin: conversations, LLM calls, tool calls).
# Self-hosted: `docker compose --profile observability up -d` → http://localhost:3000. Remove to turn off.
LANGFUSE_PUBLIC_KEY=pk-lf-sovereign-local
LANGFUSE_SECRET_KEY=sk-lf-sovereign-local
LANGFUSE_BASE_URL=http://localhost:3000
