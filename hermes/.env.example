# Sovereign KG API (REST + MCP at /mcp)
SOVEREIGN_KG_URL=http://localhost:8080

# Head Agent LLM — Ollama's OpenAI-compatible endpoint.
# Hermes requires a >=64K context window: qwen3.6:35b (262K) works;
# qwen2.5:32b (32K) is rejected. sovereign-35b pins num_ctx 8192 in its
# Modelfile, so it needs num_ctx raised to 65536 first.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_HEAD=qwen3.6:35b
