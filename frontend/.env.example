# Backend URLs (defaults shown)
VITE_KG_URL=http://localhost:8080
VITE_HERMES_URL=http://localhost:8090
VITE_RESEARCH_URL=http://localhost:8070
# People sign in (a session cookie) — the services' SOVEREIGN_TOKEN never goes into the UI. Serving the UI
# elsewhere than localhost:5173? Add its origin to SOVEREIGN_ORIGINS in kg/, hermes/ and research/ .env.
