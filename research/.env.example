# Sovereign KG API (episodes are ingested here)
SOVEREIGN_KG_URL=http://localhost:8080

# DeerFlow research model — Ollama's NATIVE API (no /v1): DeerFlow uses ChatOllama.
OLLAMA_HOST=http://localhost:11434
RESEARCH_OLLAMA_MODEL=qwen3.6:35b

# Web search: the local SearXNG by default (free engines, rate-limited — searches are paced).
# Setting one of these keys switches to that search API (free tiers: Tavily 1000/mo, Brave 2000/mo).
TAVILY_API_KEY=
BRAVE_API_KEY=
# Seconds between SearXNG searches
RESEARCH_SEARCH_INTERVAL=4

# Local search + crawler (docker compose)
SEARXNG_URL=http://localhost:8088
CRAWL4AI_URL=http://localhost:11235
CRAWL4AI_API_TOKEN=sovereign-local-crawl4ai

# DeerFlow's own state (threads, artifacts) stays inside this project
DEER_FLOW_HOME=./.deerflow-home

# Max agent steps per research run (model turns + tool calls)
RESEARCH_RECURSION_LIMIT=400

# Tracing (optional) — LangFuse (DeerFlow's built-in LangChain callback). Self-hosted:
# `docker compose --profile observability up -d` → http://localhost:3000. LANGFUSE_TRACING=false turns it off.
LANGFUSE_TRACING=true
LANGFUSE_PUBLIC_KEY=pk-lf-sovereign-local
LANGFUSE_SECRET_KEY=sk-lf-sovereign-local
LANGFUSE_BASE_URL=http://localhost:3000
