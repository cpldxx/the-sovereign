# Sovereign KG API (episodes are ingested here)
SOVEREIGN_KG_URL=http://localhost:8080

# DeerFlow research model: ollama:<model> (Ollama's NATIVE API at OLLAMA_HOST, no /v1) or anthropic:<model>
# (needs ANTHROPIC_API_KEY). The older RESEARCH_OLLAMA_MODEL=<model> still works.
OLLAMA_HOST=http://localhost:11434
RESEARCH_MODEL=ollama:qwen3.6:35b
# ANTHROPIC_API_KEY=

# Web search: the local SearXNG by default (free engines, rate-limited — searches are paced).
# Setting one of these keys switches to that search API (free tiers: Tavily 1000/mo, Brave 2000/mo).
TAVILY_API_KEY=
BRAVE_API_KEY=
# Seconds between SearXNG searches
RESEARCH_SEARCH_INTERVAL=4

# Local search + crawler (docker compose)
SEARXNG_URL=http://localhost:8088
CRAWL4AI_URL=http://localhost:11235
CRAWL4AI_API_TOKEN=sovereign-local-crawl4ai

# DeerFlow's own state (threads, artifacts) stays inside this project
DEER_FLOW_HOME=./.deerflow-home

# Max agent steps per research run (model turns + tool calls)
RESEARCH_RECURSION_LIMIT=400
# Pages ingested into the KG at once.
# RESEARCH_INGEST_PAGES=3
# A run that couldn't reach the KG before its research was done is queued once more, this many minutes later.
# RESEARCH_RETRY_MINUTES=10

# Each domain's learning cycles run on the schedule set in the UI (Settings › Learning); off stops every cycle (runs
# can still be started by hand). NIGHTLY_REVIEW_MINUTES: the Head's review budget per domain and cycle.
# RESEARCH_SCHEDULE=on
# NIGHTLY_REVIEW_MINUTES=45
# Where jobs and cycle state are kept (default ./.data).
# RESEARCH_DATA=

# Tracing (optional) — LangFuse (DeerFlow's built-in LangChain callback). Self-hosted:
# `docker compose --profile observability up -d` → http://localhost:3000. LANGFUSE_TRACING=false turns it off.
LANGFUSE_TRACING=true
LANGFUSE_PUBLIC_KEY=pk-lf-sovereign-local
LANGFUSE_SECRET_KEY=sk-lf-sovereign-local
LANGFUSE_BASE_URL=http://localhost:3000

# The services' own token for calls between them (required; never give it to a browser — people sign in).
# Same value in kg/, hermes/ and research/ .env. Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SOVEREIGN_TOKEN=
# Browser origins allowed to call the APIs with a session cookie (comma-separated) — where the UI is served.
SOVEREIGN_ORIGINS=http://localhost:5173
