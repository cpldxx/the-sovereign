# The Sovereign in Docker — `./sovereign up`. `./sovereign init` writes .env from this file, generating the secrets
# (and reusing the values of an existing kg/ hermes/ research/ .env, so a checkout's data keeps working).

# ── Generated secrets ──────────────────────────────────────────────────────────────────────────────────────────────
SOVEREIGN_TOKEN=
ARCADEDB_PASS=
CRAWL4AI_API_TOKEN=
SEARXNG_SECRET=

# ── Where it is served ─────────────────────────────────────────────────────────────────────────────────────────────
SOVEREIGN_PORT=8000
# 127.0.0.1: this machine only. 0.0.0.0 to reach it from other devices — put HTTPS in front and set COOKIE_SECURE=true.
SOVEREIGN_BIND=127.0.0.1
SOVEREIGN_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
# invite (the first account invites everyone else) | open
SIGNUP=invite

# ── Models (Ollama) ────────────────────────────────────────────────────────────────────────────────────────────────
# Ollama on this machine (a Mac: it uses the Apple GPU). `./sovereign up --ollama` switches these to the container.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_HOST=http://host.docker.internal:11434
LLM_MODEL=ollama:qwen3.6:35b
HEAD_MODEL=ollama:qwen3.6:35b
RESEARCH_OLLAMA_MODEL=qwen3.6:35b
EMBEDDING_MODEL=nomic-embed-text-v2-moe

# ── Optional ───────────────────────────────────────────────────────────────────────────────────────────────────────
# Claude for any agent: LLM_MODEL / HEAD_MODEL=anthropic:<model>
ANTHROPIC_API_KEY=
# Better web search than the free engines (free tiers)
TAVILY_API_KEY=
BRAVE_API_KEY=
# API keys sensors may use (names, comma-separated), each set below, e.g. FINNHUB_API_KEY
SENSOR_SECRETS=
# LangFuse traces (`./sovereign up --observability`; create the keys in its UI on port 3000)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
