# The Sovereign - Environment Variables

# ArcadeDB (HTTP API)
ARCADEDB_URL=http://localhost:2480
ARCADEDB_USER=root
ARCADEDB_PASS=sovereign_pass

# Silence pydantic-ai's startup banner (observability comes later via LangFuse).
PYDANTIC_AI_NO_BANNER=1

# LLM for the KG agents — pydantic-ai "<provider>:<model>" strings.
# One model for everything by default; qwen3.6:35b is MoE (~3B active), fast on Apple Silicon.
# Claude: LLM_MODEL=anthropic:claude-sonnet-5-5 and set ANTHROPIC_API_KEY.
LLM_MODEL=ollama:qwen3.6:35b
# Optional per-agent overrides:
# LLM_MODEL_INGESTOR=
# LLM_MODEL_GATEKEEPER=
# LLM_MODEL_ARCHITECT=
# LLM_MODEL_ONTOLOGIST=
# Reasoning/thinking: off is ~9x faster for extraction with no quality loss (measured).
LLM_THINKING=false
ANTHROPIC_API_KEY=

# Ollama (OpenAI-compatible endpoint) — used by ollama: models and embeddings.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Embeddings (always local). Changing the model usually changes the vector dimension:
# existing domain databases then reject new vectors until they are re-embedded.
EMBEDDING_MODEL=nomic-embed-text-v2-moe
# EMBEDDING_BASE_URL=   (defaults to OLLAMA_BASE_URL)

# OpenHands coder — LiteLLM format ("openai/<model>" for Ollama via host.docker.internal).
CODER_MODEL=openai/qwen2.5-coder:32b
