# The Sovereign - Environment Variables

# Research service (DeerFlow) — reached through the KG's MCP tools
SOVEREIGN_RESEARCH_URL=http://localhost:8070

# ArcadeDB (HTTP API)
ARCADEDB_URL=http://localhost:2480
ARCADEDB_USER=root
ARCADEDB_PASS=sovereign_pass

# Silence pydantic-ai's startup banner.
PYDANTIC_AI_NO_BANNER=1

# Daily report language (the Reporter writes in it) and how many changed entities get their summary rewritten per run.
REPORT_LANGUAGE=English
SUMMARY_REFRESH_LIMIT=150

# Tracing (optional) — LangFuse. Self-hosted: `docker compose --profile observability up -d` → http://localhost:3000.
# These are the local project's keys (docker-compose.yml); remove them to turn tracing off.
LANGFUSE_PUBLIC_KEY=pk-lf-sovereign-local
LANGFUSE_SECRET_KEY=sk-lf-sovereign-local
LANGFUSE_BASE_URL=http://localhost:3000

# LLM for the KG agents — pydantic-ai "<provider>:<model>" strings.
# One model for everything by default; qwen3.6:35b is MoE (~3B active), fast on Apple Silicon.
# Claude: LLM_MODEL=anthropic:claude-sonnet-5-5 and set ANTHROPIC_API_KEY.
LLM_MODEL=ollama:qwen3.6:35b
# Optional per-agent overrides:
# LLM_MODEL_EXTRACTOR=
# LLM_MODEL_VALIDATOR=
# LLM_MODEL_RESOLVER=
# LLM_MODEL_LINKER=
# LLM_MODEL_ONTOLOGIST=
# LLM_MODEL_SUMMARIZER=
# LLM_MODEL_REPORTER=
# Reasoning/thinking: off is ~9x faster for extraction with no quality loss (measured).
LLM_THINKING=false
# Temperature for the judging agents (Validator, Resolver, Linker) — low = consistent decisions.
LLM_DECISION_TEMPERATURE=0.1
ANTHROPIC_API_KEY=

# Ollama (OpenAI-compatible endpoint) — used by ollama: models and embeddings.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Embeddings (always local). Changing the model usually changes the vector dimension:
# existing domain databases then reject new vectors until they are re-embedded.
EMBEDDING_MODEL=nomic-embed-text-v2-moe
# EMBEDDING_BASE_URL=   (defaults to OLLAMA_BASE_URL)

# OpenHands coder — LiteLLM format ("openai/<model>" for Ollama via host.docker.internal).
CODER_MODEL=openai/qwen2.5-coder:32b
