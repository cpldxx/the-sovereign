# The Sovereign - Environment Variables

# ArcadeDB (HTTP API)
ARCADEDB_URL=http://localhost:2480
ARCADEDB_USER=root
ARCADEDB_PASS=sovereign_pass

# LLM - per agent
# Structured-output agents (ingestor/architect) use 32b: 7b fails complex
# structured extraction first-try, which triggers a pydantic-ai retry that
# sends a null-content message to Ollama -> 400 "invalid message content type".
OLLAMA_MODEL_INGESTOR=ollama:qwen2.5:32b
OLLAMA_MODEL_GATEKEEPER=ollama:qwen2.5:32b
OLLAMA_MODEL_ARCHITECT=ollama:qwen2.5:32b
# Head Agent: qwen3.6:35b (262K ctx, tools capability, verified e2e).
# sovereign-35b pins num_ctx 8192 in its Modelfile -> below Hermes's 64K
# minimum; to use it, bump num_ctx to 65536 and verify its tool-calling.
OLLAMA_MODEL_HEAD=ollama:qwen3.6:35b
OLLAMA_BASE_URL=http://localhost:11434/v1
