# The Sovereign - Environment Variables

# Research service (DeerFlow) — reached through the KG's MCP tools
SOVEREIGN_RESEARCH_URL=http://localhost:8070
# The Head (Hermes): woken when a teammate reports on a task it gave (HEAD_WAKE=off: reports wait in its inbox)
SOVEREIGN_HERMES_URL=http://localhost:8090
HEAD_WAKE=on
# Wakes per thread / per domain and hour; past them, reports wait in the inbox.
# HEAD_MAX_WAKES=4
# HEAD_WAKES_PER_HOUR=12
# The Head decides the review queue every HEAD_REVIEW_EVERY_MINUTES (0: only in the nightly sweep), each time for at
# most HEAD_REVIEW_MINUTES.
# HEAD_REVIEW_EVERY_MINUTES=30
# HEAD_REVIEW_MINUTES=10

# ArcadeDB (HTTP API)
ARCADEDB_URL=http://localhost:2480
ARCADEDB_USER=root
ARCADEDB_PASS=sovereign_pass

# Silence pydantic-ai's startup banner.
PYDANTIC_AI_NO_BANNER=1

# Daily report language (the Reporter writes in it) and how many changed entities get their summary rewritten per run.
REPORT_LANGUAGE=English
SUMMARY_REFRESH_LIMIT=150

# Tracing (optional) — LangFuse. Self-hosted: `docker compose --profile observability up -d` → http://localhost:3000.
# These are the local project's keys (docker-compose.yml); remove them to turn tracing off.
LANGFUSE_PUBLIC_KEY=pk-lf-sovereign-local
LANGFUSE_SECRET_KEY=sk-lf-sovereign-local
LANGFUSE_BASE_URL=http://localhost:3000

# LLM for the KG agents — pydantic-ai "<provider>:<model>" strings.
# One model for everything by default; qwen3.6:35b is MoE (~3B active), fast on Apple Silicon.
# Claude: LLM_MODEL=anthropic:claude-sonnet-5-5 and set ANTHROPIC_API_KEY.
LLM_MODEL=ollama:qwen3.6:35b
# Optional per-agent overrides:
# LLM_MODEL_EXTRACTOR=
# LLM_MODEL_VALIDATOR=
# LLM_MODEL_RESOLVER=
# LLM_MODEL_LINKER=
# LLM_MODEL_ONTOLOGIST=
# LLM_MODEL_SUMMARIZER=
# LLM_MODEL_REPORTER=
# LLM_MODEL_CREW=        (a teammate answering the Head's ask_agent from its desk)
# Reasoning/thinking: off is ~9x faster for extraction with no quality loss (measured).
LLM_THINKING=false
# Temperature for the judging agents (Validator, Resolver, Linker) — low = consistent decisions.
LLM_DECISION_TEMPERATURE=0.1
ANTHROPIC_API_KEY=

# Ollama (OpenAI-compatible endpoint) — used by ollama: models and embeddings.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Embeddings (always local). Changing the model usually changes the vector dimension:
# existing domain databases then reject new vectors until they are re-embedded.
EMBEDDING_MODEL=nomic-embed-text-v2-moe
# EMBEDDING_BASE_URL=   (defaults to OLLAMA_BASE_URL)

# A local model now and then writes a broken tool call (Ollama answers 500): every agent asks again this many times.
LLM_MODEL_RETRIES=2

# The services' own token for calls between them (required; never give it to a browser — people sign in).
# Same value in kg/, hermes/ and research/ .env. Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SOVEREIGN_TOKEN=
# Browser origins allowed to call the APIs with a session cookie (comma-separated) — where the UI is served.
SOVEREIGN_ORIGINS=http://localhost:5173
# Accounts. SIGNUP: invite (an admin's invite link; default) | open (anyone). The first account is the admin and
# owns the domains that existed before accounts. SESSION_DAYS: how long a sign-in lasts.
SIGNUP=invite
SESSION_DAYS=30
# true once the UI is served over HTTPS (the session cookie is then sent over HTTPS only)
COOKIE_SECURE=false
# MCP web_search / read_webpage calls per minute and caller (they reach the internet for whoever calls).
# MCP_PROXY_CALLS_PER_MINUTE=30
