# The Sovereign - Environment Variables

# ArcadeDB (HTTP API)
ARCADEDB_URL=http://localhost:2480
ARCADEDB_USER=root
ARCADEDB_PASS=sovereign_pass

# LLM — pydantic-ai model strings ("ollama:<model>"), served from OLLAMA_BASE_URL.
# Change any model freely; pull it first with `ollama pull <model>`.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Structured-output agents use 32b: 7b fails complex structured extraction
# first-try, and the pydantic-ai retry then hits an Ollama 400.
OLLAMA_MODEL_INGESTOR=ollama:qwen2.5:32b
OLLAMA_MODEL_GATEKEEPER=ollama:qwen2.5:32b
OLLAMA_MODEL_ARCHITECT=ollama:qwen2.5:32b
OLLAMA_MODEL_ONTOLOGIST=ollama:qwen3.6:35b
# OpenHands coder — LiteLLM format ("openai/<model>").
OLLAMA_MODEL_CODER=openai/qwen2.5-coder:32b
# Embeddings — OpenAI-compatible /embeddings at OLLAMA_BASE_URL.
# Switching models usually changes the vector dimension: existing domain
# databases then reject new vectors until they are re-embedded.
OLLAMA_MODEL_EMBEDDING=nomic-embed-text-v2-moe
