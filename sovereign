#!/usr/bin/env bash
# Sovereign — run the whole system from one place.
#
#   ./sovereign up [--ollama] [--observability]
#                                          EVERYTHING IN DOCKER: settings, models, images, then the whole stack;
#                                          the UI on http://localhost:8000 (--ollama: Ollama in a container too)
#   ./sovereign down                       stop the containers (data stays in ./data and the volumes)
#   ./sovereign init                       write .env (generated secrets) — `up` does it when it's missing
#
#   ./sovereign start [--observability]   development: docker services, then KG, Hermes, Research and the UI as
#                                          processes on this machine (Apple GPU voice), detached
#   ./sovereign stop                       stop the four app services (docker containers keep running)
#   ./sovereign restart [--observability]
#   ./sovereign status                     what is up
#   ./sovereign logs <kg|hermes|research|frontend>
#   ./sovereign autostart on|off           start at login (macOS LaunchAgent; Docker Desktop must start at login too)
#   ./sovereign test [all]                 the test suite (all: also the slow ones — the local model, the internet)
#   ./sovereign selfcheck                  the security self-check on the running system
#   ./sovereign hooks                      install the git hooks (no secrets / data / co-author lines in commits)
#
# Logs: .logs/<service>.log · PIDs: .run/<service>.pid
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOGS="$ROOT/.logs"
RUN="$ROOT/.run"
AGENT="$HOME/Library/LaunchAgents/com.sovereign.start.plist"
mkdir -p "$LOGS" "$RUN"

# name  directory  port  command
SERVICES=(
  "kg|kg|8080|uv run python main.py"
  "hermes|hermes|8090|uv run python server.py"
  "research|research|8070|uv run python server.py"
  "frontend|frontend|5173|npm run dev"
)

field() { echo "$1" | cut -d'|' -f"$2"; }
port_pid() { lsof -tiTCP:"$1" -sTCP:LISTEN 2>/dev/null | head -1; }

start_service() {
  local name dir port cmd
  name=$(field "$1" 1); dir=$(field "$1" 2); port=$(field "$1" 3); cmd=$(field "$1" 4)
  if [[ -n "$(port_pid "$port")" ]]; then
    echo "  $name: already running on :$port"
    return
  fi
  (cd "$ROOT/$dir" && nohup bash -c "exec $cmd" >>"$LOGS/$name.log" 2>&1 & echo $! >"$RUN/$name.pid")
  echo "  $name: starting on :$port (log: .logs/$name.log)"
}

stop_service() {
  local name port pid
  name=$(field "$1" 1); port=$(field "$1" 3)
  pid=$(cat "$RUN/$name.pid" 2>/dev/null || true)
  [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
  # The process that holds the port (uvicorn / vite may run under the recorded one).
  pid=$(port_pid "$port"); [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
  rm -f "$RUN/$name.pid"
  echo "  $name: stopped"
}

status() {
  for s in "${SERVICES[@]}"; do
    local name port; name=$(field "$s" 1); port=$(field "$s" 3)
    if [[ -n "$(port_pid "$port")" ]]; then echo "  ● $name  :$port"; else echo "  ○ $name  :$port (down)"; fi
  done
  (cd "$ROOT" && docker compose ps --format '  ● {{.Service}}  {{.Status}}' 2>/dev/null) || echo "  docker: not running"
}

# Whether the Docker stack (./sovereign up) is what's running, rather than the development processes.
docker_mode() { (cd "$ROOT" && docker compose --profile app ps --status running --services 2>/dev/null) | grep -qx kg; }

start() {
  if docker_mode; then
    echo "The Docker stack is running (./sovereign up) — stop it first: ./sovereign down"; exit 1
  fi
  local profile=()
  [[ "${1:-}" == "--observability" ]] && profile=(--profile observability)
  echo "docker services"
  (cd "$ROOT" && docker compose ${profile[@]+"${profile[@]}"} up -d >/dev/null 2>&1) && echo "  up"
  echo "app services"
  for s in "${SERVICES[@]}"; do start_service "$s"; done
  echo "UI: http://localhost:5173"
}

# ── Docker: init / up ─────────────────────────────────────────────────────────────────────────────────────────────

init_env() {
  # .env from .env.example: secrets generated, values of an existing checkout's service .env files reused.
  if [[ -f "$ROOT/.env" ]]; then echo ".env exists — leaving it as is"; return; fi
  python3 - "$ROOT" <<'PY'
import secrets, sys
from pathlib import Path
root = Path(sys.argv[1])
existing = {}
for name in ("research/.env", "hermes/.env", "kg/.env"):          # kg last: it wins
    f = root / name
    if f.exists():
        for line in f.read_text().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                if v.strip():
                    existing[k.strip()] = v.strip()
generate = {"SOVEREIGN_TOKEN": 32, "ARCADEDB_PASS": 18, "CRAWL4AI_API_TOKEN": 24, "SEARXNG_SECRET": 24}
legacy = {"ARCADEDB_PASS": "sovereign_pass", "CRAWL4AI_API_TOKEN": "sovereign-local-crawl4ai",
          "SEARXNG_SECRET": "sovereign-local-searxng"}
docker_side = {"OLLAMA_BASE_URL", "OLLAMA_HOST", "SOVEREIGN_ORIGINS", "LANGFUSE_BASE_URL"}  # differ inside Docker
out = []
for line in (root / ".env.example").read_text().splitlines():
    if "=" in line and not line.lstrip().startswith("#"):
        k, v = line.split("=", 1)
        if k in existing and k not in docker_side:
            v = existing[k]
        elif k in generate:
            # A checkout that ran before keeps its database password (the ArcadeDB volume was made with it).
            v = legacy[k] if (root / "kg/.env").exists() and k in legacy else secrets.token_urlsafe(generate[k])
        line = f"{k}={v}"
    out.append(line)
(root / ".env").write_text("\n".join(out) + "\n")
(root / ".env").chmod(0o600)
print("wrote .env (secrets generated" + (", values reused from the service .env files)" if existing else ")"))
PY
}

env_get() { grep -h "^$1=" "$ROOT/.env" 2>/dev/null | tail -1 | cut -d= -f2-; }
env_set() {  # env_set KEY VALUE — in .env
  python3 - "$ROOT/.env" "$1" "$2" <<'PY'
import sys
from pathlib import Path
f, k, v = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
lines = [f"{k}={v}" if l.startswith(f"{k}=") else l for l in f.read_text().splitlines()]
if not any(l.startswith(f"{k}=") for l in lines):
    lines.append(f"{k}={v}")
f.write_text("\n".join(lines) + "\n")
PY
}

# Docker Desktop's credential helper can hang (a locked keychain, a stuck backend), and every pull then waits forever.
# Every image here is public: when the helper doesn't answer, pull and build without it — the user's config untouched.
skip_stuck_helper() {
  local cfg="${DOCKER_CONFIG:-$HOME/.docker}" helper endpoint tmp pid
  helper=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("credsStore",""))' "$cfg/config.json" 2>/dev/null)
  [[ -n "$helper" ]] && command -v "docker-credential-$helper" >/dev/null || return 0
  "docker-credential-$helper" get <<< "https://index.docker.io/v1/" >/dev/null 2>&1 &
  pid=$!
  for _ in $(seq 1 10); do kill -0 "$pid" 2>/dev/null || return 0; sleep 1; done
  kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null || true
  endpoint=$(docker context inspect -f '{{.Endpoints.docker.Host}}' 2>/dev/null)
  tmp=$(mktemp -d); echo '{}' > "$tmp/config.json"
  [[ -d "$cfg/cli-plugins" ]] && ln -s "$cfg/cli-plugins" "$tmp/cli-plugins"
  export DOCKER_CONFIG="$tmp"
  [[ -n "$endpoint" ]] && export DOCKER_HOST="$endpoint"
  echo "note: Docker's credential helper ($helper) isn't answering — pulling the public images without it"
}

up() {
  local ollama=host observability=()
  for a in "$@"; do
    case "$a" in
      --ollama) ollama=container ;;
      --observability) observability=(--profile observability) ;;
    esac
  done
  command -v docker >/dev/null || { echo "Docker is needed: https://docs.docker.com/get-docker/"; exit 1; }
  docker info >/dev/null 2>&1 || { echo "Docker isn't running — start Docker Desktop (or the docker service) first"; exit 1; }
  skip_stuck_helper
  init_env
  # The development processes use the same database: never both at once.
  for s in "${SERVICES[@]}"; do [[ -n "$(port_pid "$(field "$s" 3)")" ]] && stop_service "$s" >/dev/null; done
  # A checkout's data, the first time: domains, the source catalog, research runs, Hermes' home.
  if [[ ! -d "$ROOT/data" ]]; then
    mkdir -p "$ROOT/data/kg/domains" "$ROOT/data/research/jobs" "$ROOT/data/hermes"
    for d in "$ROOT"/kg/domains/*/; do
      n=$(basename "$d"); [[ "$n" == _* ]] && continue; cp -R "$d" "$ROOT/data/kg/domains/$n"
    done
    [[ -f "$ROOT/kg/.scout-catalog.json" ]] && cp "$ROOT/kg/.scout-catalog.json" "$ROOT/data/kg/scout-catalog.json"
    [[ -f "$ROOT/research/.data/jobs.json" ]] && cp "$ROOT/research/.data/jobs.json" "$ROOT/data/research/jobs/"
    [[ -d "$ROOT/hermes/.hermes-home" ]] && cp -R "$ROOT/hermes/.hermes-home" "$ROOT/data/hermes/hermes-home"
  fi
  local profiles=(--profile app)
  local models=("$(env_get LLM_MODEL)" "$(env_get HEAD_MODEL)" "ollama:$(env_get RESEARCH_OLLAMA_MODEL)" "ollama:$(env_get EMBEDDING_MODEL)")
  if [[ "$ollama" == container ]]; then
    profiles+=(--profile ollama)
    env_set OLLAMA_BASE_URL http://ollama:11434/v1; env_set OLLAMA_HOST http://ollama:11434
    [[ "$(uname)" == Darwin ]] && echo "note: Ollama in Docker on a Mac runs on the CPU (no Apple GPU) — slow for a 35B model"
    (cd "$ROOT" && docker compose --profile ollama up -d ollama >/dev/null)
    pull() { (cd "$ROOT" && docker compose exec -T ollama ollama pull "$1"); }
    have() { (cd "$ROOT" && docker compose exec -T ollama ollama list) 2>/dev/null | awk '{print $1}' | grep -qx "$1"; }
  else
    curl -fsS -m 5 http://localhost:11434/api/tags >/dev/null 2>&1 || {
      echo "Ollama isn't running on this machine. Install it (https://ollama.com) and start it — or use: ./sovereign up --ollama"
      exit 1; }
    pull() { ollama pull "$1"; }
    have() { curl -fsS -m 5 http://localhost:11434/api/tags | python3 -c "import json,sys; n=sys.argv[1]; m=[x['name'] for x in json.load(sys.stdin)['models']]; sys.exit(0 if n in m or n+':latest' in m else 1)" "$1"; }
  fi
  for m in $(printf '%s\n' "${models[@]}" | grep '^ollama:' | sed 's/^ollama://' | sort -u); do
    have "$m" || { echo "pulling model $m (once; large models take a while)…"; pull "$m"; }
  done
  echo "building the sensor sandbox image…"
  docker build -q -t sovereign-sandbox:4 "$ROOT/docker/sandbox" >/dev/null
  echo "building and starting the containers (the first build takes several minutes)…"
  (cd "$ROOT" && docker compose "${profiles[@]}" ${observability[@]+"${observability[@]}"} up -d --build)
  local port; port=$(env_get SOVEREIGN_PORT); port=${port:-8000}
  printf "waiting for the services"
  for _ in $(seq 1 90); do
    curl -fsS -m 3 "http://localhost:$port/api/kg/health" >/dev/null 2>&1 && { echo; echo "The Sovereign is up: http://localhost:$port — create the first account there."; return; }
    printf "."; sleep 2
  done
  echo; echo "not answering yet — see: docker compose --profile app logs -f kg"
}

case "${1:-}" in
  start) start "${2:-}" ;;
  stop) for s in "${SERVICES[@]}"; do stop_service "$s"; done ;;
  restart) for s in "${SERVICES[@]}"; do stop_service "$s"; done; sleep 2; start "${2:-}" ;;
  status) status ;;
  logs) tail -n 100 -f "$LOGS/${2:?which service: kg | hermes | research | frontend}.log" ;;
  test)
    # Against the Docker stack the live tests go through nginx, like the browser.
    if docker_mode; then
      port=$(env_get SOVEREIGN_PORT); export SOVEREIGN_TEST_BASE="http://localhost:${port:-8000}/api"
      SOVEREIGN_TOKEN=$(env_get SOVEREIGN_TOKEN); ARCADEDB_PASS=$(env_get ARCADEDB_PASS); export SOVEREIGN_TOKEN ARCADEDB_PASS
    fi
    if [[ "${2:-}" == "all" ]]; then (cd "$ROOT/kg" && uv run pytest -q); else (cd "$ROOT/kg" && uv run pytest -q -m "not slow"); fi ;;
  selfcheck)
    if docker_mode; then
      token=$(env_get SOVEREIGN_TOKEN); port=$(env_get SOVEREIGN_PORT); url="http://localhost:${port:-8000}/api/kg"
    else
      token=$(grep -h '^SOVEREIGN_TOKEN=' "$ROOT/kg/.env" | cut -d= -f2-); url="http://localhost:8080"
    fi
    curl -s -X POST -H "Authorization: Bearer $token" "$url/system/selfcheck?alert=false" \
      | python3 -c "import json,sys; r=json.load(sys.stdin); print('OK' if r['ok'] else 'FAILED'); [print(f'  {k:9} {v[\"status\"]:12} {v[\"detail\"]}') for k,v in r['checks'].items()]" ;;
  hooks)
    git -C "$ROOT" config core.hooksPath scripts/git-hooks && echo "git hooks installed (scripts/git-hooks)" ;;
  autostart)
    case "${2:-}" in
      on)
        mkdir -p "$(dirname "$AGENT")"
        cat >"$AGENT" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sovereign.start</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-lc</string><string>sleep 60; '$ROOT/sovereign' start</string></array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$LOGS/autostart.log</string>
  <key>StandardErrorPath</key><string>$LOGS/autostart.log</string>
</dict>
</plist>
EOF
        launchctl unload "$AGENT" 2>/dev/null || true
        launchctl load "$AGENT"
        echo "Sovereign starts at login ($AGENT)" ;;
      off)
        launchctl unload "$AGENT" 2>/dev/null || true
        rm -f "$AGENT"
        echo "autostart removed" ;;
      *) echo "usage: ./sovereign autostart on|off"; exit 1 ;;
    esac ;;
  init) init_env ;;
  up) up "${@:2}" ;;
  down) (cd "$ROOT" && docker compose --profile app --profile ollama --profile observability stop) ;;
  *) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
